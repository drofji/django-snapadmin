# SnapAdmin Environment Variables
# Copy this file to .env and fill in your values.
# All variables have sensible defaults for local development.
# For production, change SECRET_KEY, DEBUG, ALLOWED_HOSTS, and credentials.


# ── Django core ───────────────────────────────────────────────────────────────

# A secret random string used for cryptographic signing.
# MUST be changed to a long random value in production.
# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production

# Enable Django debug mode. Set to False in production.
DEBUG=True

# Comma-separated list of hostnames that can serve the app.
# Use * to allow all (dev only). Set your real domain in production.
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0


# ── Logging ───────────────────────────────────────────────────────────────────

# Minimum log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Output structured JSON logs instead of human-readable text.
# Set to True in production/Docker for log aggregation (Datadog, Loki, etc.).
JSON_LOGS=False


# ── PostgreSQL ────────────────────────────────────────────────────────────────

# Database name
POSTGRES_DB=snapadmin

# Database user
POSTGRES_USER=snapadmin

# Database password
POSTGRES_PASSWORD=snapadmin

# Database host. When running with Docker Compose, use the service name ("db").
# Leave empty to fall back to SQLite (local dev without Docker).
POSTGRES_HOST=db

# Database port (default PostgreSQL port)
POSTGRES_PORT=5432


# ── Redis / Celery ────────────────────────────────────────────────────────────

# Redis connection URL used as Celery broker and result backend.
# When running with Docker Compose, use the service name ("redis").
REDIS_URL=redis://redis:6379/0


# ── Elasticsearch ─────────────────────────────────────────────────────────────

# Elasticsearch cluster URL
ELASTICSEARCH_URL=http://elasticsearch:9200

# Enable/disable Elasticsearch integration.
# When False, all models fall back to DB_ONLY mode regardless of es_storage_mode.
# Set to True only when an ES cluster is available.
ELASTICSEARCH_ENABLED=False


# ── SnapAdmin-specific ────────────────────────────────────────────────────────

# Automatically run the seed_demo management command on app startup.
# Useful for quick demo setup; disable in production or staging environments.
SNAPADMIN_AUTO_SEED=False

# Collapses the ~90 settings in this section to one line for a project that
# does not want to decide each one individually: "admin" (admin UI only,
# REST/GraphQL off) | "api" (REST + GraphQL on) | "full" (today's defaults).
# An explicit setting below always wins over the profile.
SNAPADMIN_PROFILE=full

# Feature toggles — switch each API surface off independently.
# False removes the corresponding URL routes entirely (404).
SNAPADMIN_REST_API_ENABLED=True
SNAPADMIN_SWAGGER_ENABLED=True
SNAPADMIN_GRAPHQL_ENABLED=True

# Optional extra path segment prepended to every snapadmin route (REST/Swagger/
# GraphQL). Set e.g. SNAPADMIN_URL_PREFIX=snapadmin/ when your project already owns
# the mount point (e.g. /api/). Empty = historical layout.
SNAPADMIN_URL_PREFIX=

# The system dashboard exposes infrastructure details, so it is staff-gated by
# default. Set to True only for an intentionally public status page.
SNAPADMIN_DASHBOARD_PUBLIC=False

# With the optional django-unfold theme installed, re-register Django's built-in
# User/Group admins with Unfold's theme and forms so the auth screens match the
# rest of the site — and so the password row keeps a working "Reset password"
# button (Unfold's template renders it empty against Django's own forms). A
# project that has customised its UserAdmin is never touched. False = opt out.
SNAPADMIN_THEME_AUTH_ADMIN=True

# Project-wide default for every SnapField's show_in_form, useful when adopting
# SnapAdmin onto models that never set it per field (an unset field otherwise
# always resolves to False, which can generate an empty change form). An
# explicit per-field show_in_form= always wins over this.
SNAPADMIN_SHOW_IN_FORM_DEFAULT=False

# The connectivity/offline layer (health poll, save-blocking guard while the
# backend is confirmed down, sidebar sync badge) is opt-in and defaults to
# False — it also only loads when at least one registered model has
# offline_mode=True. The demo turns it on to dogfood Customer's offline mode.
SNAPADMIN_CONNECTIVITY_ENABLED=True

# Admin-only user-management API (/api/users/, /api/permissions/). Opt-in.
SNAPADMIN_USER_API_ENABLED=True

# API authentication classes (comma-separated dotted paths). Empty = the demo
# default (SnapAdmin token auth + Django session). Add JWT, e.g.:
#   snapadmin.api.authentication.APITokenAuthentication,rest_framework_simplejwt.authentication.JWTAuthentication
SNAPADMIN_API_AUTHENTICATION_CLASSES=

# Elasticsearch client request timeout (seconds), merged into ELASTICSEARCH_KWARGS.
ELASTICSEARCH_TIMEOUT=5

# Smart ES query routing: route `?search=` API requests on DUAL-storage models
# to Elasticsearch (fuzzy, relevance-ranked) instead of DB icontains.
# Only takes effect when ELASTICSEARCH_ENABLED=True; per-model opt-out via
# `es_query_routing = False` on the model class.
SNAPADMIN_ES_QUERY_ROUTING=True

# Max hits fetched from Elasticsearch per routed search / ES_ONLY listing.
SNAPADMIN_ES_SEARCH_LIMIT=1000

# Project-wide default for the ES query layer's database fallback. True (default)
# lets es_filter/es_aggregate/es_count/es_scan silently fall back to the database
# when Elasticsearch is disabled or a query errors. Set False to make them raise
# SnapEsUnavailable instead (safer on a large, DB-unindexable table where the
# fallback scan is worse than a clear failure). Per-call override: db_fallback=.
SNAPADMIN_ES_DB_FALLBACK=True

# Expose the X-Snap-Query-Backend response header (elasticsearch|database) on
# API list responses. Set False to hide the routing detail in production.
SNAPADMIN_QUERY_BACKEND_HEADER=True

# Read-replica routing (issue #15): a DATABASES alias that auto-generated
# read-only API list/retrieve queries are pinned to via .using(). Writes always
# stay on 'default'. Empty = no routing (single-database default).
# (SNAPADMIN_MASKED_FIELDS / _MASKING_RULES / _SSO_PROVIDERS / _NESTED_APPS are
#  dict settings — configure them in settings.py, not here.)
SNAPADMIN_ANALYTICS_DB_ALIAS=

# Audit trail (issue #7 — DORA / ISO 27001): record every admin create/update/
# delete as an immutable SnapadminAuditLog. Retention drives the --purge pass of
# `manage.py snapadmin_audit_export`.
SNAPADMIN_AUDIT_LOG_ENABLED=True
SNAPADMIN_AUDIT_RETENTION_DAYS=365

# Row-level multi-tenancy (#FUT1): SNAPADMIN_TENANT_RESOLVER /
# _TENANT_USER_RESOLVER are dotted-path settings, so they are set in
# settings.py (not as env vars) — see demo/core/tenancy.py.

# Large-dataset performance (issue #5): use PostgreSQL's fast reltuples estimate
# instead of COUNT(*) for unfiltered changelists larger than the threshold.
# Exact count on small/filtered views and non-PostgreSQL databases.
SNAPADMIN_ESTIMATED_COUNT=True
SNAPADMIN_ESTIMATED_COUNT_THRESHOLD=100000

# Async background export (issue #6): POST /api/exports/ offloads large CSV/JSON
# exports to a Celery worker with progress tracking, cancel and resumable chunks.
SNAPADMIN_EXPORT_ENABLED=True
SNAPADMIN_EXPORT_CHUNK_SIZE=1000
# SNAPADMIN_EXPORT_DIR defaults to <BASE_DIR>/exports; point it at a persistent
# volume in production (leave unset to use the default):
# SNAPADMIN_EXPORT_DIR=/data/snapadmin-exports
# SNAPADMIN_EXPORT_STORAGE: dotted path to a django.core.files.storage.Storage
# subclass export files are published to and downloaded from. Leave unset for
# the default local FileSystemStorage rooted at SNAPADMIN_EXPORT_DIR — set this
# when the web process and the Celery worker run on separate filesystems (e.g.
# an S3/GCS-backed storage class), so a completed job is downloadable from any
# web instance, not just the one that happens to share disk with the worker.
# SNAPADMIN_EXPORT_STORAGE=storages.backends.s3.S3Storage
# SNAPADMIN_EXPORT_SOURCES is a {name: "dotted.path.to.factory"} dict, so it is set
# in settings.py (not as an env var). A SnapExportJob with source="name" then uses
# that custom row source instead of the default ORM export. The demo registers
# "product_catalog" (see demo/apps/shop/export_sources.py).
# Unset (default): finished export/reindex job rows and their files are kept
# forever. Set a positive number of days to delete them past that age (plus a
# sweep for any export file left behind with no job row) — see #gdpr in the docs.
# SNAPADMIN_EXPORT_RETENTION_DAYS=30

# Rows per snapadmin_import chunk — the checkpoint/resume granularity.
SNAPADMIN_IMPORT_CHUNK_SIZE=1000

# Admin-only bulk ES reindex over HTTP (POST /api/es/reindex/, IsAdminUser).
# Off by default (the endpoint 404s while disabled). Turn REINDEX_API_ASYNC on to
# offload the reindex to the snapadmin.run_es_reindex Celery task (needs a broker).
SNAPADMIN_REINDEX_API_ENABLED=False
SNAPADMIN_REINDEX_API_ASYNC=False
# Default for `snapadmin_reindex --tune` (relax refresh/replicas for a mass load)
# when neither --tune nor --no-tune is passed. False keeps tuning off by default.
SNAPADMIN_REINDEX_TUNE_DEFAULT=False

# GraphQL security: require authentication + per-model view permission on every
# resolver (mirrors the REST API). Never set to False in production.
SNAPADMIN_GRAPHQL_REQUIRE_AUTH=True

# GraphiQL playground. Defaults to the DEBUG value — keep out of production.
SNAPADMIN_GRAPHIQL_ENABLED=True

# --- API capacity & abuse protection ------------------------------------------
# These bound per-request cost and caller rate. They are deployment-owned on
# purpose and are NOT exposed as runtime-editable admin settings, so changing one
# is a deploy, not a web-form edit.

# API throttling (DRF): anonymous callers vs authenticated clients.
# Leave a value empty to disable that throttle entirely.
SNAPADMIN_THROTTLE_ANON=60/min
SNAPADMIN_THROTTLE_USER=600/min

# Which CACHES entry snapadmin.limits.reserve() stores its per-tenant/per-token
# quota counters in. Point this at a shared cache (Redis, Memcached, ...) before
# relying on it across more than one worker process — 'default' is per-process here.
SNAPADMIN_LIMITS_CACHE_ALIAS=default

# REST list pagination: default page size, and the hard ceiling a client may
# request via ?page_size=.
SNAPADMIN_API_PAGE_SIZE=25
SNAPADMIN_API_MAX_PAGE_SIZE=500
# Project-wide default lookup set for auto-generated REST text-field filters
# (comma-separated). Unset = library default (exact,icontains,startswith,in). Drop
# icontains to make the index-friendly posture the default for every text field.
# SNAPADMIN_API_TEXT_LOOKUPS=exact,startswith,in
# Filter-backend chain for the model REST API (comma-separated dotted paths). Unset =
# built-in [SnapAdminFilterBackend, SearchFilter, OrderingFilter]. Set to swap in a
# custom FilterSet/backend; it replaces the whole chain, so list every backend wanted.
# SNAPADMIN_API_FILTER_BACKEND=myapp.filters.MyBackend,rest_framework.filters.OrderingFilter
# Row-scan ceiling for api_json_filters on a backend without native JSON containment
# (e.g. SQLite): past this many rows the JSON filter answers 400 instead of scanning
# the table into memory. Ignored on PostgreSQL/MySQL (lazy native lookup). Default 100000.
SNAPADMIN_API_JSON_FILTER_SCAN_CAP=100000

# Hard cap on the 'values' list length for the fetch-by route (POST
# /api/models/<app>/<Model>/fetch-by/) — over this many values, 400 instead of
# an unbounded query.
SNAPADMIN_FETCH_BY_MAX_VALUES=10000

# Synchronous streaming export limits. MAX_ROWS is the row count above which the
# endpoint answers 413 and points at the async export API (0 = unlimited);
# LIMIT_MAX clamps an explicit ?limit= (0 = no clamp).
SNAPADMIN_EXPORT_MAX_ROWS=0
SNAPADMIN_EXPORT_LIMIT_MAX=0

# Password for the superuser that seed_demo creates. When unset, the insecure
# admin/admin default is used — allowed only while DEBUG=True.
SNAPADMIN_SEED_ADMIN_PASSWORD=


# ── Email (SMTP) — required for error alerts / daily digest ─────────────────

# Django email backend. Defaults to the console backend while DEBUG=True
# (emails are printed to stdout) and SMTP when DEBUG=False.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# SMTP server connection
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# From address for all SnapAdmin notification emails
DEFAULT_FROM_EMAIL=snapadmin@localhost


# ── Error monitoring (optional email notifications) ─────────────────────────

# Master switch: record every unhandled exception / 5xx response as an
# ErrorEvent (browsable in the admin) via SnapErrorMonitorMiddleware.
SNAPADMIN_ERROR_MONITOR_ENABLED=True

# Spike alert: when at least THRESHOLD errors occur within WINDOW_MINUTES,
# one email is sent to ALERT_EMAILS (comma-separated). At most one alert per
# COOLDOWN_MINUTES (unset falls back to WINDOW_MINUTES); no emails are sent
# while ALERT_EMAILS is empty.
SNAPADMIN_ERROR_ALERT_ENABLED=True
SNAPADMIN_ERROR_ALERT_THRESHOLD=20
SNAPADMIN_ERROR_ALERT_WINDOW_MINUTES=15
SNAPADMIN_ERROR_ALERT_COOLDOWN_MINUTES=15
SNAPADMIN_ERROR_ALERT_EMAILS=

# Daily digest: grouped 24h error report sent by Celery Beat at HOUR:MINUTE
# (or `manage.py snapadmin_send_error_digest` from cron). Falls back to ALERT_EMAILS
# when DIGEST_EMAILS is empty. MAX_GROUPS caps the number of distinct error
# groups in one email so it never explodes.
SNAPADMIN_ERROR_DIGEST_ENABLED=True
SNAPADMIN_ERROR_DIGEST_EMAILS=
SNAPADMIN_ERROR_DIGEST_MAX_GROUPS=20
SNAPADMIN_ERROR_DIGEST_HOUR=8
SNAPADMIN_ERROR_DIGEST_MINUTE=0

# ErrorEvent rows older than this many days are purged by the digest task.
SNAPADMIN_ERROR_RETENTION_DAYS=30

# Health alert: email when a subsystem probe (DB / Elasticsearch / REST API /
# GraphQL, each skipped when its feature toggle is off) is down. The same checks
# as `snapadmin_info --health-check`, run on a schedule (the send-health-alert
# Beat entry, or `manage.py snapadmin_health_alert` from cron).
# Recipients fall back to SNAPADMIN_ERROR_ALERT_EMAILS when HEALTH_ALERT_EMAILS
# is empty; a persistent outage emails at most once per COOLDOWN_MINUTES. No
# emails are sent while both recipient lists are empty.
SNAPADMIN_HEALTH_ALERT_ENABLED=True
SNAPADMIN_HEALTH_ALERT_EMAILS=
SNAPADMIN_HEALTH_ALERT_COOLDOWN_MINUTES=60

# Alert channels: the spike alert, the daily digest and the health alert are
# delivered by email *and* by any chat webhook configured below (Slack, Discord
# and Teams incoming webhooks, or a Telegram bot). Posted with the standard
# library — no extra dependency. Leaving these empty keeps alerting email-only.
# These URLs/tokens are credentials: anyone holding one can post to your channel,
# so keep them here in the environment and out of source control.
# Set EMAIL_ENABLED=False for a chat-only deployment with no mail server at all.
SNAPADMIN_ALERT_EMAIL_ENABLED=True
SNAPADMIN_ALERT_WEBHOOK_TIMEOUT=5
SNAPADMIN_ALERT_SLACK_WEBHOOK=
SNAPADMIN_ALERT_DISCORD_WEBHOOK=
SNAPADMIN_ALERT_TEAMS_WEBHOOK=
# The Telegram pair is wired to outages only (health + error spike), not the digest.
SNAPADMIN_ALERT_TELEGRAM_TOKEN=
SNAPADMIN_ALERT_TELEGRAM_CHAT_ID=


# ── Static, media & export storage ───────────────────────────────────────────
# Local disk is the default and is fine for a single container. The moment you run
# more than one, media must move off the local filesystem: a file uploaded through
# instance A is a 404 on instance B, and a container restart loses it.
#
#   local  — FileSystemStorage + WhiteNoise for static (the default)
#   s3     — any S3-compatible object storage (AWS S3, Hetzner Object Storage,
#            MinIO, Backblaze B2). Needs: pip install "django-storages[s3]"
#
# Hetzner Storage Box is NOT S3 — it speaks SFTP / CIFS(SMB) / WebDAV. Mount it on
# the host and keep local storage, pointing the media volume at the mount:
#   //u123456.your-storagebox.de/backup  /mnt/box  cifs  credentials=/etc/box.cred,uid=1000  0 0
# For *backups* you don't need a mount at all — SNAPADMIN_BACKUP_SFTP_* below talks
# to a Storage Box directly.
SNAPADMIN_STORAGE_BACKEND=local

# --- S3-compatible object storage (only read when STORAGE_BACKEND=s3) --------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Endpoint. Leave EMPTY for real AWS S3 — boto3 derives it from the region.
#   AWS S3               (empty)                                  + region eu-central-1
#   Hetzner Object Store https://fsn1.your-objectstorage.com      + region fsn1
#                        (also hel1 / nbg1 — use the bucket's own location)
#   MinIO / self-hosted  https://minio.example.com                + region us-east-1
#   Backblaze B2         https://s3.eu-central-003.backblazeb2.com + region eu-central-003
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Optional CDN / custom domain in front of the bucket. Without it, file URLs point
# at the bucket endpoint directly.
AWS_S3_CUSTOM_DOMAIN=

# True  → every file URL is a time-limited signed link (correct for a PRIVATE
#         bucket holding user uploads; this is the default on purpose).
# False → plain public URLs; only for a bucket you intend to be world-readable.
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600

# Never overwrite an existing key — Django suffixes the name instead. A silent
# overwrite is how one user's upload destroys another's file.
AWS_S3_FILE_OVERWRITE=False

# Most modern buckets have ACLs disabled; sending one then fails the upload.
# Leave empty unless your provider requires e.g. public-read.
AWS_DEFAULT_ACL=

# 'virtual' (bucket.host) suits AWS and Hetzner; 'path' (host/bucket) suits MinIO
# and anything without wildcard DNS.
AWS_S3_ADDRESSING_STYLE=virtual

# Static files are public, immutable and already compressed by WhiteNoise, so
# serving them from the app is usually fine. Set True to put them on the bucket
# too (typically together with AWS_S3_CUSTOM_DOMAIN as a CDN).
SNAPADMIN_STATIC_ON_S3=False

# Async export files: when the web process and the Celery worker do not share a
# filesystem, a finished export is only downloadable from the instance that wrote
# it. Point SNAPADMIN_EXPORT_STORAGE at the same bucket to fix that:
#   SNAPADMIN_EXPORT_STORAGE=storages.backends.s3.S3Storage


# ── 3-2-1 database backups (optional) ────────────────────────────────────────
# 3 copies, 2 machines, 1 offsite. Each destination has its own frequency;
# the hourly Celery Beat task (api.tasks.run_db_backups) or a cron entry
# running `manage.py snapadmin_db_backup` ships dumps only when a destination is due.

# Master switch for scheduled backups.
SNAPADMIN_BACKUP_ENABLED=False

# How many dumps to keep per destination (oldest pruned first).
SNAPADMIN_BACKUP_KEEP=7

# Copy 1 — LOCAL: directory on this server. Also stages every dump.
SNAPADMIN_BACKUP_LOCAL_DIR=./backups
SNAPADMIN_BACKUP_LOCAL_EVERY_HOURS=24

# Copy 2 — NETWORK: directory on another server on the same network,
# reachable as a mounted share (NFS/SMB). Empty = destination disabled.
SNAPADMIN_BACKUP_NETWORK_DIR=
SNAPADMIN_BACKUP_NETWORK_EVERY_HOURS=24

# Copy 3 — REMOTE (offsite): FTP/FTPS server somewhere else in the world.
# Empty host = destination disabled. Weekly by default (168 h).
SNAPADMIN_BACKUP_FTP_HOST=
SNAPADMIN_BACKUP_FTP_PORT=21
SNAPADMIN_BACKUP_FTP_USER=
SNAPADMIN_BACKUP_FTP_PASSWORD=
SNAPADMIN_BACKUP_FTP_DIR=/
SNAPADMIN_BACKUP_FTP_TLS=False
SNAPADMIN_BACKUP_REMOTE_EVERY_HOURS=168

# Copy 3 (alternative) — SFTP over SSH (encrypted offsite transport).
# Requires the optional paramiko dependency: pip install django-snapadmin[backup]
# Empty host = destination disabled. Leave SFTP_KEY_FILE set to use key auth
# (SFTP_PASSWORD is ignored then); otherwise password auth is used. Weekly by default.
SNAPADMIN_BACKUP_SFTP_HOST=
SNAPADMIN_BACKUP_SFTP_PORT=22
SNAPADMIN_BACKUP_SFTP_USER=
SNAPADMIN_BACKUP_SFTP_PASSWORD=
SNAPADMIN_BACKUP_SFTP_KEY_FILE=
SNAPADMIN_BACKUP_SFTP_DIR=/
SNAPADMIN_BACKUP_SFTP_EVERY_HOURS=168

# Copy 3 (alternative) — any S3-compatible object store (AWS, MinIO, Backblaze B2,
# Hetzner Object Storage, Wasabi). Requires the optional boto3 dependency:
# pip install django-snapadmin[s3]. ENDPOINT_URL picks the provider — leave unset
# for AWS. Leave ACCESS_KEY_ID/SECRET_ACCESS_KEY unset to use boto3's ambient
# credential chain instead (env vars, shared config, an IAM role / instance
# profile) — the right choice on AWS. Hetzner Storage Box is SFTP, not S3 — see
# SNAPADMIN_BACKUP_SFTP_* above. Empty bucket = destination disabled.
SNAPADMIN_BACKUP_S3_BUCKET=
SNAPADMIN_BACKUP_S3_PREFIX=
SNAPADMIN_BACKUP_S3_ENDPOINT_URL=
SNAPADMIN_BACKUP_S3_REGION=
SNAPADMIN_BACKUP_S3_ACCESS_KEY_ID=
SNAPADMIN_BACKUP_S3_SECRET_ACCESS_KEY=
SNAPADMIN_BACKUP_S3_EVERY_HOURS=168

# Encryption at rest — comma-separated age (age1…) and/or SSH public keys.
# Every dump is streamed straight through age before a byte reaches disk when
# this is non-empty; empty (the default) changes nothing. The identity (private
# key) is never set here — supply it only at restore time.
SNAPADMIN_BACKUP_AGE_RECIPIENTS=
# Restore-only: path to a private-key file (never the key material itself).
SNAPADMIN_BACKUP_AGE_IDENTITY_FILE=
# auto (prefers pyrage, falls back to the `age` binary) / pyrage / binary.
SNAPADMIN_BACKUP_AGE_BACKEND=auto
# Override the `age` executable path for the binary backend (default: PATH lookup).
SNAPADMIN_BACKUP_AGE_BINARY_PATH=

# What a backup run bundles: comma-separated subset of db,media,env.
# "env" requires SNAPADMIN_BACKUP_AGE_RECIPIENTS to be set — refused otherwise.
SNAPADMIN_BACKUP_INCLUDE=db
# Comma-separated glob patterns excluded from the media tar.
SNAPADMIN_BACKUP_MEDIA_EXCLUDE=
# Path to the .env file backed up when "env" is in SNAPADMIN_BACKUP_INCLUDE.
SNAPADMIN_BACKUP_ENV_FILE=./.env
# Past this many bytes, a media backup logs a warning (still runs — never aborts).
SNAPADMIN_BACKUP_MEDIA_SIZE_WARNING_BYTES=10737418240

# Pre-restore safety net: snapadmin_restore snapshots the current live state before a
# --confirmed restore touches anything. Empty = a rollback/ subdir of the local backup dir.
SNAPADMIN_RESTORE_SNAPSHOT_DIR=
# How many snapshots to keep (oldest pruned first) — separate from SNAPADMIN_BACKUP_KEEP.
SNAPADMIN_RESTORE_SNAPSHOT_KEEP=3


# ── Traefik (optional reverse proxy) ─────────────────────────────────────────
# These variables are only used when running one of the Traefik overlay files:
#   docker compose -f docker-compose.yml -f docker-compose.traefik.local.yml up --build
#   docker compose -f docker-compose.yml -f docker-compose.traefik.prod.yml up -d

# Production domain — used by docker-compose.traefik.prod.yml
# Example: admin.mycompany.com
TRAEFIK_DOMAIN=yourdomain.com

# Email for Let's Encrypt TLS certificate registration (production only)
TRAEFIK_ACME_EMAIL=your@email.com

# Reference credentials — for your own records; not used directly by Traefik
TRAEFIK_DASHBOARD_USER=admin
TRAEFIK_DASHBOARD_PASSWORD=changeme

# Traefik dashboard BasicAuth in htpasswd format (used by both local and prod overlays)
# Generate from USER / PASSWORD above:
#   echo $(htpasswd -nb "${TRAEFIK_DASHBOARD_USER}" "${TRAEFIK_DASHBOARD_PASSWORD}") | sed -e 's/\$/\$\$/g'
# Default below matches admin / changeme — CHANGE in production.
TRAEFIK_DASHBOARD_CREDENTIALS=admin:$$apr1$$9O1qgAeJ$$DEirfr7.WrkwuPt2yUqY7.
