msgstr "Имя"

msgid "Task"
msgstr "Задача"

msgid "Schedule"
msgstr "Расписание"

msgid "Description"
msgstr "Описание"

msgid "Data Distribution"
msgstr "Распределение данных"

msgid "Bar chart of record counts per managed model"
msgstr "Столбчатая диаграмма количества записей по каждой управляемой модели"

msgid "System Health"
msgstr "Состояние системы"

