msgid "Access Control"
msgstr "Контроль доступа"

msgid "Audit"
msgstr "Аудит"

#, python-format
msgid "API token created. Copy it now — it will not be shown again: %(key)s"
msgstr ""
"Токен API создан. Скопируйте его сейчас — он больше не будет показан: %(key)s"

msgid "Token Key"
msgstr "Ключ токена"

msgid "hidden — shown only once at creation"
msgstr "скрыто — показывается только один раз при создании"

msgid "Status"
msgstr "Статус"

msgid "Disabled"
msgstr "Отключён"

msgid "Expired"
msgstr "Истёк"

msgid "Active"
msgstr "Активен"

msgid "Message"
msgstr "Сообщение"

msgid "Audit timeline"
msgstr "Хронология аудита"

msgid "Changes"
msgstr "Изменения"

msgid "Timeline"
msgstr "Хронология"

msgid "View the full change timeline"
msgstr "Открыть полную хронологию изменений"

msgid "Object"
msgstr "Объект"

msgid "Action"
msgstr "Действие"

msgid "Allowed models must be a list."
msgstr "Разрешённые модели должны быть списком."

#, python-format
msgid "Invalid model format: '%(item)s'."
msgstr "Неверный формат модели: '%(item)s'."

#, python-format
msgid "Model '%(item)s' does not exist."
msgstr "Модель '%(item)s' не существует."

msgid "Token Name"
msgstr "Имя токена"

msgid ""
"A descriptive name for this token (e.g. 'CI Pipeline', 'Read-only "
"dashboard')."
msgstr ""
"Описательное имя для этого токена (напр. 'CI Pipeline', 'Панель только для "
"чтения')."

msgid "Token Prefix"
msgstr "Префикс токена"

msgid "First 8 characters of the key, for identification. Not secret."
msgstr "Первые 8 символов ключа для идентификации. Не является секретом."

msgid "Token Digest"
msgstr "Дайджест токена"

msgid ""
"SHA-256 hash of the secret key. The raw key is never stored — it is shown "
"only once, at creation."
msgstr ""
"SHA-256-хеш секретного ключа. Исходный ключ никогда не хранится — он "
"показывается только один раз, при создании."

msgid "Owner"
msgstr "Владелец"

msgid "Expiration Date"
msgstr "Дата истечения срока"

msgid "Leave blank for a token that never expires."
msgstr "Оставьте пустым, чтобы токен никогда не истекал."

msgid "Allowed Models"
msgstr "Разрешённые модели"

msgid "List of 'app_label.ModelName' strings this token can access."
msgstr "Список строк 'app_label.ModelName', к которым этот токен имеет доступ."

msgid "Is Active"
msgstr "Активен"

msgid "Inactive tokens are rejected without being deleted."
msgstr "Неактивные токены отклоняются без удаления."

msgid "Created At"
msgstr "Создано"

msgid "Last Used At"
msgstr "Последнее использование"

msgid "API Token"
msgstr "Токен API"

msgid "API Tokens"
msgstr "Токены API"

msgid "Can view unmasked PII data"
msgstr "Может просматривать немаскированные PII-данные"

msgid "Exception"
msgstr "Исключение"

msgid ""
"Exception class name, or HTTP<code> for a 5xx response without an exception."
msgstr "Имя класса исключения или HTTP<code> для ответа 5xx без исключения."

msgid "Path"
msgstr "Путь"

msgid "Method"
msgstr "Метод"

msgid "Status Code"
msgstr "Код статуса"

msgid "Fingerprint"
msgstr "Отпечаток"

msgid "SHA-256 of exception class + path — groups repeats of the same error."
msgstr ""
"SHA-256 от класса исключения + пути — группирует повторы одной и той же "
"ошибки."

msgid "Traceback"
msgstr "Трассировка"

msgid "Occurred At"
msgstr "Произошло"

msgid "Error Event"
msgstr "Событие ошибки"

msgid "Error Events"
msgstr "События ошибок"

msgid "Created"
msgstr "Создано"

msgid "Updated"
msgstr "Обновлено"

msgid "Deleted"
msgstr "Удалено"

msgid "Actor"
msgstr "Субъект"

msgid "Actor (snapshot)"
msgstr "Субъект (снимок)"

msgid "IP Address"
msgstr "IP-адрес"

msgid "User Agent"
msgstr "User-Agent"

msgid "Content Type"
msgstr "Тип содержимого"

msgid "App Label"
msgstr "Метка приложения"

msgid "Model"
msgstr "Модель"

msgid "Object ID"
msgstr "ID объекта"

msgid "Before/after field diff, if any."
msgstr "Разница полей до/после, если есть."

msgid "Timestamp"
msgstr "Отметка времени"

msgid "Audit Log"
msgstr "Журнал аудита"

msgid "Audit Logs"
msgstr "Журналы аудита"

msgid "Audit log entries are immutable and cannot be modified."
msgstr "Записи журнала аудита неизменяемы и не могут быть изменены."

msgid "Audit log entries are immutable and cannot be deleted."
msgstr "Записи журнала аудита неизменяемы и не могут быть удалены."

msgid "Pending"
msgstr "Ожидает"

msgid "Processing"
msgstr "Обрабатывается"

msgid "Completed"
msgstr "Завершено"

msgid "Failed"
msgstr "Ошибка"

msgid "Cancelled"
msgstr "Отменено"

msgid "Format"
msgstr "Формат"

msgid "Filters"
msgstr "Фильтры"

msgid "ORM field=value filters applied to the export queryset."
msgstr "ORM-фильтры поле=значение, применяемые к queryset экспорта."

msgid "Row Source"
msgstr "Источник строк"

msgid ""
"Registered SNAPADMIN_EXPORT_SOURCES name; blank uses the default ORM source."
msgstr ""
"Имя из SNAPADMIN_EXPORT_SOURCES; пусто — используется стандартный ORM-"
"источник."

msgid "Total Rows"
msgstr "Всего строк"

msgid "Processed Rows"
msgstr "Обработано строк"

msgid "Rows written so far — drives progress-percent and ETA reporting."
msgstr ""
"Записано строк на данный момент — определяет процент выполнения и оценку "
"времени."

msgid "Resume Cursor (PK)"
msgstr "Курсор возобновления (PK)"

msgid ""
"Primary key of the last exported row; blank means start from the beginning."
msgstr ""
"Первичный ключ последней экспортированной строки; пусто — начать с начала."

msgid "Resume Byte Offset"
msgstr "Смещение байтов возобновления"

msgid "Byte length of the working file confirmed at cursor_pk."
msgstr "Длина рабочего файла в байтах, подтверждённая на cursor_pk."

msgid "File Name"
msgstr "Имя файла"

msgid "Error"
msgstr "Ошибка"

msgid "Requested By"
msgstr "Запрошено"

msgid "Started At"
msgstr "Начато"

msgid "Finished At"
msgstr "Завершено"

msgid "Export Job"
msgstr "Задание экспорта"

msgid "Export Jobs"
msgstr "Задания экспорта"

msgid ""
"Primary key of the last indexed row; blank means start from the beginning."
msgstr ""
"Первичный ключ последней проиндексированной строки; пусто — начать с начала."

msgid "Reindex Job"
msgstr "Задание переиндексации"

msgid "Reindex Jobs"
msgstr "Задания переиндексации"

msgid "Field"
msgstr "Поле"

msgid "Before"
msgstr "До"

msgid "After"
msgstr "После"

msgid "No field-level diff was recorded for this action."
msgstr "Для этого действия не записаны изменения по полям."

msgid "Back to the audit log"
msgstr "Назад к журналу аудита"

#, python-format
msgid "Audit entries for %(target)s"
msgstr "Записи аудита для %(target)s"

#, python-format
msgid ""
"Showing the %(limit)s most recent entries. Use <code>manage.py "
"snapadmin_audit_export</code> for the full history."
msgstr ""
"Показаны %(limit)s последних записей. Полная история — через <code>manage.py snapadmin_audit_export</code>."

msgid "anonymous"
msgstr "аноним"

#, python-format
msgid "by %(actor)s"
msgstr "автор: %(actor)s"

msgid "No audit entries have been recorded for this object."
msgstr "Для этого объекта не записано ни одной записи аудита."

msgid "Skip to main content"
msgstr "Перейти к основному содержимому"

msgid "SnapAdmin on GitHub (opens in a new tab)"
msgstr "SnapAdmin на GitHub (откроется в новой вкладке)"

msgid "System entry points"
msgstr "Точки входа в систему"

msgid "System Entry Points"
msgstr "Точки входа в систему"

msgid "Managed Models"
msgstr "Управляемые модели"

msgid "Scheduled Cron Jobs"
msgstr "Запланированные задачи"

