msgstr "Volver al registro de auditoría"

#, python-format
msgid "Audit entries for %(target)s"
msgstr "Entradas de auditoría para %(target)s"

#, python-format
msgid ""
"Showing the %(limit)s most recent entries. Use <code>manage.py "
"snapadmin_audit_export</code> for the full history."
msgstr ""
"Se muestran las %(limit)s entradas más recientes. Use <code>manage.py "
"snapadmin_audit_export</code> para el historial completo."

