msgid "Access Control"
msgstr "Controllo degli accessi"

msgid "Audit"
msgstr "Audit"

#, python-format
msgid "API token created. Copy it now — it will not be shown again: %(key)s"
msgstr "Token API creato. Copialo ora — non verrà mostrato di nuovo: %(key)s"

msgid "Token Key"
msgstr "Chiave del token"

msgid "hidden — shown only once at creation"
msgstr "nascosto — mostrato solo una volta alla creazione"

msgid "Status"
msgstr "Stato"

msgid "Disabled"
msgstr "Disattivato"

msgid "Expired"
msgstr "Scaduto"

msgid "Active"
msgstr "Attivo"

msgid "Message"
msgstr "Messaggio"

msgid "Audit timeline"
msgstr "Cronologia di audit"

msgid "Changes"
msgstr "Modifiche"

msgid "Timeline"
msgstr "Cronologia"

msgid "View the full change timeline"
msgstr "Visualizza la cronologia completa delle modifiche"

msgid "Object"
msgstr "Oggetto"

msgid "Action"
msgstr "Azione"

msgid "Allowed models must be a list."
msgstr "I modelli consentiti devono essere un elenco."

#, python-format
msgid "Invalid model format: '%(item)s'."
msgstr "Formato del modello non valido: '%(item)s'."

#, python-format
msgid "Model '%(item)s' does not exist."
msgstr "Il modello '%(item)s' non esiste."

msgid "Token Name"
msgstr "Nome del token"

msgid ""
"A descriptive name for this token (e.g. 'CI Pipeline', 'Read-only "
"dashboard')."
msgstr ""
"Un nome descrittivo per questo token (es. 'CI Pipeline', 'Dashboard di sola "
"lettura')."

msgid "Token Prefix"
msgstr "Prefisso del token"

msgid "First 8 characters of the key, for identification. Not secret."
msgstr ""
"I primi 8 caratteri della chiave, per l'identificazione. Non è segreto."

msgid "Token Digest"
msgstr "Digest del token"

msgid ""
"SHA-256 hash of the secret key. The raw key is never stored — it is shown "
"only once, at creation."
msgstr ""
"Hash SHA-256 della chiave segreta. La chiave grezza non viene mai "
"memorizzata — viene mostrata solo una volta, alla creazione."

msgid "Owner"
msgstr "Proprietario"

msgid "Expiration Date"
msgstr "Data di scadenza"

msgid "Leave blank for a token that never expires."
msgstr "Lasciare vuoto per un token che non scade mai."

msgid "Allowed Models"
msgstr "Modelli consentiti"

msgid "List of 'app_label.ModelName' strings this token can access."
msgstr ""
"Elenco di stringhe 'app_label.ModelName' a cui questo token può accedere."

msgid "Is Active"
msgstr "È attivo"

msgid "Inactive tokens are rejected without being deleted."
msgstr "I token inattivi vengono rifiutati senza essere eliminati."

msgid "Created At"
msgstr "Creato il"

msgid "Last Used At"
msgstr "Ultimo utilizzo il"

msgid "API Token"
msgstr "Token API"

msgid "API Tokens"
msgstr "Token API"

msgid "Can view unmasked PII data"
msgstr "Può visualizzare i dati PII non mascherati"

msgid "Exception"
msgstr "Eccezione"

msgid ""
"Exception class name, or HTTP<code> for a 5xx response without an exception."
msgstr ""
"Nome della classe di eccezione, o HTTP<code> per una risposta 5xx senza "
"eccezione."

msgid "Path"
msgstr "Percorso"

msgid "Method"
msgstr "Metodo"

msgid "Status Code"
msgstr "Codice di stato"

msgid "Fingerprint"
msgstr "Impronta"

msgid "SHA-256 of exception class + path — groups repeats of the same error."
msgstr ""
"SHA-256 della classe di eccezione + percorso — raggruppa le ripetizioni "
"dello stesso errore."

msgid "Traceback"
msgstr "Traceback"

msgid "Occurred At"
msgstr "Verificato il"

msgid "Error Event"
msgstr "Evento di errore"

msgid "Error Events"
msgstr "Eventi di errore"

msgid "Created"
msgstr "Creato"

msgid "Updated"
msgstr "Aggiornato"

msgid "Deleted"
msgstr "Eliminato"

msgid "Actor"
msgstr "Autore"

msgid "Actor (snapshot)"
msgstr "Autore (istantanea)"

msgid "IP Address"
msgstr "Indirizzo IP"

msgid "User Agent"
msgstr "User agent"

msgid "Content Type"
msgstr "Tipo di contenuto"

msgid "App Label"
msgstr "Etichetta dell'app"

msgid "Model"
msgstr "Modello"

msgid "Object ID"
msgstr "ID dell'oggetto"

msgid "Before/after field diff, if any."
msgstr "Differenza dei campi prima/dopo, se presente."

msgid "Timestamp"
msgstr "Marca temporale"

msgid "Audit Log"
msgstr "Registro di audit"

msgid "Audit Logs"
msgstr "Registri di audit"

msgid "Audit log entries are immutable and cannot be modified."
msgstr ""
"Le voci del registro di audit sono immutabili e non possono essere "
"modificate."

msgid "Audit log entries are immutable and cannot be deleted."
msgstr ""
"Le voci del registro di audit sono immutabili e non possono essere eliminate."

msgid "Pending"
msgstr "In attesa"

msgid "Processing"
msgstr "In elaborazione"

msgid "Completed"
msgstr "Completato"

msgid "Failed"
msgstr "Non riuscito"

msgid "Cancelled"
msgstr "Annullato"

msgid "Format"
msgstr "Formato"

msgid "Filters"
msgstr "Filtri"

msgid "ORM field=value filters applied to the export queryset."
msgstr "Filtri ORM campo=valore applicati al queryset di esportazione."

msgid "Row Source"
msgstr "Sorgente righe"

msgid ""
"Registered SNAPADMIN_EXPORT_SOURCES name; blank uses the default ORM source."
msgstr ""
"Nome registrato in SNAPADMIN_EXPORT_SOURCES; vuoto usa la sorgente ORM "
"predefinita."

msgid "Total Rows"
msgstr "Righe totali"

msgid "Processed Rows"
msgstr "Righe elaborate"

msgid "Rows written so far — drives progress-percent and ETA reporting."
msgstr ""
"Righe scritte finora — determina la percentuale di avanzamento e la stima "
"del tempo rimanente."

msgid "Resume Cursor (PK)"
msgstr "Cursore di ripresa (PK)"

msgid ""
"Primary key of the last exported row; blank means start from the beginning."
msgstr ""
"Chiave primaria dell'ultima riga esportata; vuoto significa iniziare "
"dall'inizio."

msgid "Resume Byte Offset"
msgstr "Offset di byte di ripresa"

msgid "Byte length of the working file confirmed at cursor_pk."
msgstr "Lunghezza in byte del file di lavoro confermata a cursor_pk."

msgid "File Name"
msgstr "Nome del file"

msgid "Error"
msgstr "Errore"

msgid "Requested By"
msgstr "Richiesto da"

msgid "Started At"
msgstr "Avviato il"

msgid "Finished At"
msgstr "Terminato il"

msgid "Export Job"
msgstr "Attività di esportazione"

msgid "Export Jobs"
msgstr "Attività di esportazione"

msgid ""
"Primary key of the last indexed row; blank means start from the beginning."
msgstr ""
"Chiave primaria dell'ultima riga indicizzata; vuoto significa iniziare "
"dall'inizio."

msgid "Reindex Job"
msgstr "Attività di reindicizzazione"

msgid "Reindex Jobs"
msgstr "Attività di reindicizzazione"

msgid "Field"
msgstr "Campo"

msgid "Before"
msgstr "Prima"

msgid "After"
msgstr "Dopo"

msgid "No field-level diff was recorded for this action."
msgstr ""
"Per questa azione non è stata registrata alcuna differenza per campo."

msgid "Back to the audit log"
msgstr "Torna al registro di audit"

#, python-format
msgid "Audit entries for %(target)s"
msgstr "Voci di audit per %(target)s"

#, python-format
msgid ""
"Showing the %(limit)s most recent entries. Use <code>manage.py "
"snapadmin_audit_export</code> for the full history."
msgstr ""
"Vengono mostrate le %(limit)s voci più recenti. Usa <code>manage.py snapadmin_audit_export</code> per la cronologia completa."

msgid "anonymous"
msgstr "anonimo"

#, python-format
msgid "by %(actor)s"
msgstr "da %(actor)s"

msgid "No audit entries have been recorded for this object."
msgstr "Per questo oggetto non è stata registrata alcuna voce di audit."

msgid "Skip to main content"
msgstr "Vai al contenuto principale"

msgid "SnapAdmin on GitHub (opens in a new tab)"
msgstr "SnapAdmin su GitHub (si apre in una nuova scheda)"

