"""
URL configuration for $project_name.

Generated by snapadmin-new. `/` redirects to the admin. The REST API, Swagger docs and
GraphQL endpoint SnapAdmin builds from $app_name's models live under /api/.
"""

from django.conf import settings
from django.contrib import admin
from django.contrib.staticfiles.urls import staticfiles_urlpatterns
from django.urls import include, path
from django.views.generic import RedirectView

urlpatterns = [
    path("", RedirectView.as_view(url="admin/", permanent=False)),
    path("admin/", admin.site.urls),
    path("api/", include("snapadmin.urls")),
]

if settings.DEBUG:
    # Serves static files (admin CSS/JS) under any WSGI server while DEBUG=True, not
    # just `runserver` — so the admin still looks right behind gunicorn (--full's
    # Docker image). Never enable in real production; put WhiteNoise, nginx or a CDN
    # in front instead.
    urlpatterns += staticfiles_urlpatterns()
