# Generated by snapadmin-new for $project_name.
# settings.py reads these with os.getenv(..., <safe default>), so nothing here is
# required for local development — this file only matters once you deploy or run
# `docker compose up` (--full).

SECRET_KEY=$secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Toggle each SnapAdmin surface independently.
SNAPADMIN_REST_API_ENABLED=True
SNAPADMIN_SWAGGER_ENABLED=True
SNAPADMIN_GRAPHQL_ENABLED=True
SNAPADMIN_GRAPHIQL_ENABLED=True

# DRF rate limits (empty value disables that throttle).
SNAPADMIN_THROTTLE_ANON=60/min
SNAPADMIN_THROTTLE_USER=600/min
$full_env_extra
